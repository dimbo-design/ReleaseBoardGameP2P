# --- Transfer folder: NEVER commit ---
# user_input is a one-way drop zone for source materials.
# We only copy OUT of it into the project — it must never reach GitHub.
user_input/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Node / build ---
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Worktrees ---
# Isolated checkouts of this same repo. Each carries its own .git and must
# never enter the tree: unignored, a stray `add -A` in the main checkout
# commits an entire second copy of the project.
.worktrees/
.claude/worktrees/

superpowers
docs/superpowers
.superpowers
